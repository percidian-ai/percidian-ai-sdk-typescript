{
    "name": "percidian",
    "version": "0.1.1",
    "private": false,
    "license": "Apache-2.0",
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./jobs": {
            "import": {
                "types": "./dist/esm/api/resources/jobs/exports.d.mts",
                "default": "./dist/esm/api/resources/jobs/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/jobs/exports.d.ts",
                "default": "./dist/cjs/api/resources/jobs/exports.js"
            },
            "default": "./dist/cjs/api/resources/jobs/exports.js"
        },
        "./batches": {
            "import": {
                "types": "./dist/esm/api/resources/batches/exports.d.mts",
                "default": "./dist/esm/api/resources/batches/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/batches/exports.d.ts",
                "default": "./dist/cjs/api/resources/batches/exports.js"
            },
            "default": "./dist/cjs/api/resources/batches/exports.js"
        },
        "./ontologies": {
            "import": {
                "types": "./dist/esm/api/resources/ontologies/exports.d.mts",
                "default": "./dist/esm/api/resources/ontologies/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/ontologies/exports.d.ts",
                "default": "./dist/cjs/api/resources/ontologies/exports.js"
            },
            "default": "./dist/cjs/api/resources/ontologies/exports.js"
        },
        "./limits": {
            "import": {
                "types": "./dist/esm/api/resources/limits/exports.d.mts",
                "default": "./dist/esm/api/resources/limits/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/limits/exports.d.ts",
                "default": "./dist/cjs/api/resources/limits/exports.js"
            },
            "default": "./dist/cjs/api/resources/limits/exports.js"
        },
        "./webhooks": {
            "import": {
                "types": "./dist/esm/api/resources/webhooks/exports.d.mts",
                "default": "./dist/esm/api/resources/webhooks/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/webhooks/exports.d.ts",
                "default": "./dist/cjs/api/resources/webhooks/exports.js"
            },
            "default": "./dist/cjs/api/resources/webhooks/exports.js"
        },
        "./usage": {
            "import": {
                "types": "./dist/esm/api/resources/usage/exports.d.mts",
                "default": "./dist/esm/api/resources/usage/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/usage/exports.d.ts",
                "default": "./dist/cjs/api/resources/usage/exports.js"
            },
            "default": "./dist/cjs/api/resources/usage/exports.js"
        },
        "./webhooks/endpoints": {
            "import": {
                "types": "./dist/esm/api/resources/webhooks/resources/endpoints/exports.d.mts",
                "default": "./dist/esm/api/resources/webhooks/resources/endpoints/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/webhooks/resources/endpoints/exports.d.ts",
                "default": "./dist/cjs/api/resources/webhooks/resources/endpoints/exports.js"
            },
            "default": "./dist/cjs/api/resources/webhooks/resources/endpoints/exports.js"
        },
        "./webhooks/deliveries": {
            "import": {
                "types": "./dist/esm/api/resources/webhooks/resources/deliveries/exports.d.mts",
                "default": "./dist/esm/api/resources/webhooks/resources/deliveries/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/webhooks/resources/deliveries/exports.d.ts",
                "default": "./dist/cjs/api/resources/webhooks/resources/deliveries/exports.js"
            },
            "default": "./dist/cjs/api/resources/webhooks/resources/deliveries/exports.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "reference.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format": "biome format --write --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "format:check": "biome format --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint": "biome lint --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint:fix": "biome lint --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check": "biome check --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check:fix": "biome check --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "build": "pnpm build:cjs && pnpm build:esm",
        "build:cjs": "tsc --project ./tsconfig.cjs.json",
        "build:esm": "tsc --project ./tsconfig.esm.json && node scripts/rename-to-esm-files.js dist/esm",
        "test": "vitest",
        "test:unit": "vitest --project unit",
        "test:wire": "vitest --project wire"
    },
    "dependencies": {},
    "devDependencies": {
        "webpack": "^5.105.4",
        "ts-loader": "^9.5.4",
        "vitest": "^4.1.1",
        "msw": "2.11.2",
        "@types/node": "^20.0.0",
        "typescript": "~5.9.3",
        "@biomejs/biome": "2.4.10"
    },
    "browser": {
        "fs": false,
        "os": false,
        "path": false,
        "stream": false,
        "crypto": false
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=18"
    },
    "sideEffects": false,
    "description": "Percidian's TypeScript SDK for Percept One.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/percidian-ai/percidian-ai-sdk-typescript.git"
    }
}
